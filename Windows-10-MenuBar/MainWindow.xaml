<Window x:Class="Windows_10_MenuBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Windows_10_MenuBar.ViewModels"
        Title="MenuBar" Height="32" Width="800"
        WindowStyle="None" AllowsTransparency="True" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Foreground="White"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Window.Background>
        <!-- BarStop0 ve BarStop1 GradientThemeService tarafından anime edilir -->
        <LinearGradientBrush x:Name="BarGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop x:Name="BarStop0" Color="#1A1A1A" Offset="0"/>
            <GradientStop x:Name="BarStop1" Color="#1A1A1A" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.CacheMode>
        <!-- GPU katmanı — gradient renk değişimleri layout/measure tetiklemez
             RenderAtScale=1.0 — HiDPI ekranlarda optimize rendering
             EnableClearType=False — animasyon sırasında text anti-aliasing off (performans) -->
        <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" RenderAtScale="1.0"/>
    </Window.CacheMode>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tray Button Style (normal button) -->
        <Style x:Key="TrayBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#20FFFFFF" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Box Style (for Border elements like Battery/Time) -->
        <Style x:Key="TrayBox" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tray ToggleButton Style -->
        <Style x:Key="TrayToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#20FFFFFF" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Popup Panel Base Style -->
        <Style x:Key="PopupBorder" TargetType="Border">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Effect" Value="{x:Null}"/>
                </Style>
                <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Effect" Value="{x:Null}"/>
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="#F51A1A1A"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" Opacity="0.55" ShadowDepth="4" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Hover -->
        <Style x:Key="HoverListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#18FFFFFF" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Section Label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <!-- Settings Row Label -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Theme Chip Button -->
        <Style x:Key="ThemeChip" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ch" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ch" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Ch" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Flash Storyboard — yeni bildirim gelince bar kısa süre parlıyor -->
        <Storyboard x:Key="SbFlash" Timeline.DesiredFrameRate="30">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="FlashOverlay"
                Storyboard.TargetProperty="Opacity"
                FillBehavior="Stop">
                <DiscreteDoubleKeyFrame KeyTime="0"        Value="0"/>
                <LinearDoubleKeyFrame   KeyTime="0:0:0.15" Value="0.35"/>
                <LinearDoubleKeyFrame   KeyTime="0:0:1.2"  Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid Background="Transparent"
          MouseWheel="Grid_MouseWheel"
          MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.ContextMenu>
            <ContextMenu Background="#E6202020" Foreground="White" BorderThickness="1" BorderBrush="#33FFFFFF">
                <MenuItem Header="⚙ Ayarlar" Click="OpenSettings_Click"/>
                <MenuItem Header="Çıkış" Click="BtnClose_Click" Foreground="#FF5555"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Yeni bildirim flash overlay — bar'ın tamamını kısa süre aydınlatır -->
        <Border x:Name="FlashOverlay"
                Background="White" Opacity="0"
                IsHitTestVisible="False"
                CornerRadius="0" Panel.ZIndex="999"/>

        <!-- Settings Popup (right-click) -->
        <Popup x:Name="SettingsPopup" StaysOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=SettingsPopup}"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupBorder}" Width="370" MaxHeight="580" Padding="20,16">
                <!-- DropShadow removal is handled by PopupBorder resources -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="20" Foreground="#3366FF" Margin="0,0,10,0"/>
                            <TextBlock Text="Ayarlar" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <TextBlock Text="GÖRÜNÜM" Style="{StaticResource SectionLabel}"/>

                        <!-- Theme Buttons -->
                        <TextBlock Text="Hazır Temalar" FontSize="12" Foreground="#AAA" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="Dark" Style="{StaticResource ThemeChip}" Background="#1A1A1A" BorderBrush="#444"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Dark"/>
                            <Button Content="Midnight" Style="{StaticResource ThemeChip}" Background="#0D0D1A" BorderBrush="#2A2A4A"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Midnight"/>
                            <Button Content="Blue" Style="{StaticResource ThemeChip}" Background="#0D1A2A" BorderBrush="#2A4A6A"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Blue Tint"/>
                            <Button Content="Purple" Style="{StaticResource ThemeChip}" Background="#1A0D2A" BorderBrush="#4A2A6A"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Purple"/>
                            <Button Content="Forest" Style="{StaticResource ThemeChip}" Background="#0D1A0D" BorderBrush="#2A4A2A"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Forest"/>
                            <Button Content="Glass" Style="{StaticResource ThemeChip}" Background="#333333" BorderBrush="#555"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Glass"/>
                            <Button Content="🌌 Aurora" Style="{StaticResource ThemeChip}" Background="#050720" BorderBrush="#003A8F"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Aurora"/>
                            <Button Content="🌅 Sunset" Style="{StaticResource ThemeChip}" Background="#1A0600" BorderBrush="#C85000"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Sunset"/>
                            <Button Content="🌊 Ocean" Style="{StaticResource ThemeChip}" Background="#00081A" BorderBrush="#004E9A"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Ocean"/>
                            <Button Content="💨 Rüzgar" Style="{StaticResource ThemeChip}" Background="#08101E" BorderBrush="#284A72"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Wind"/>
                            <Button Content="🖼 Duvar Kağıdı" Style="{StaticResource ThemeChip}" Background="#2A2A3A" BorderBrush="#5566FF"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Auto"/>
                        </WrapPanel>

                        <!-- HEX Color -->
                        <TextBlock Text="Özel Renk (HEX)" FontSize="12" Foreground="#AAA" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1AFFFFFF" CornerRadius="6">
                                <TextBox x:Name="TxtHexColor" Background="Transparent" Foreground="White" BorderThickness="0"
                                         Padding="8,6" FontSize="12.5"
                                         Text="{Binding Settings.CustomHexColor, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                            <Button Grid.Column="1" Content="Uygula" Margin="8,0,0,0" Padding="14,6"
                                    Background="#3366FF" Foreground="White" BorderThickness="0"
                                    Command="{Binding ApplyThemeCommand}" CommandParameter="Custom"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Opacity -->
                        <TextBlock Text="Saydamlık" Style="{StaticResource RowLabel}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0.3" Maximum="1.0" SmallChange="0.05"
                                    Value="{Binding BarOpacity, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_Changed"/>
                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="{Binding BarOpacity, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Bar Height -->
                        <TextBlock Text="Bar Yüksekliği" Style="{StaticResource RowLabel}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="24" Maximum="44" SmallChange="2" IsSnapToTickEnabled="True" TickFrequency="2"
                                    Value="{Binding Settings.BarHeight, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    ValueChanged="HeightSlider_Changed"/>
                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="{Binding Settings.BarHeight, StringFormat='{}{0:F0}px'}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Weather Opacity -->
                        <TextBlock Text="Hava Durumu Şeffaflığı" Style="{StaticResource RowLabel}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="1.0" SmallChange="0.05"
                                    Value="{Binding Settings.WeatherOpacity, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="{Binding Settings.WeatherOpacity, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Weather City -->
                        <TextBlock Text="Hava Durumu Konumu" Style="{StaticResource RowLabel}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" Margin="0,0,4,0" Background="#1AFFFFFF" Foreground="White"
                                      ItemsSource="{Binding Provinces}"
                                      SelectedItem="{Binding Settings.WeatherProvince, Mode=TwoWay}"
                                      ToolTip="İl Seçiniz (Seçilmezse otomatik)"/>
                                      
                            <ComboBox Grid.Column="1" Margin="4,0,8,0" Background="#1AFFFFFF" Foreground="White"
                                      ItemsSource="{Binding Districts}"
                                      SelectedItem="{Binding Settings.WeatherDistrict, Mode=TwoWay}"
                                      ToolTip="İlçe Seçiniz"/>

                            <Button Grid.Column="2" Content="Yenile" Padding="14,6"
                                    Background="#3366FF" Foreground="White" BorderThickness="0"
                                    Command="{Binding RefreshWeatherCommand}"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,0,0,14"/>

                        <!-- BEHAVIOR -->
                        <TextBlock Text="DAVRANIŞ" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="24 Saat Formatı" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.Use24HourClock, Mode=TwoWay}"
                                            Click="Settings_Changed"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Otomatik Gizle" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoHide, Mode=TwoWay}"
                                            Click="AutoHide_Changed"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tam Ekranda Gizle" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Oyun ve video gibi tam ekran uygulamalarda barı gizler"
                                           FontSize="10" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.HideOnFullscreen, Mode=TwoWay}"
                                            Click="Settings_Changed" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Windows ile Başlat" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}"
                                            Click="StartWithWindows_Changed"/>
                        </Grid>

                        <!-- Zamanlı Tema -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Zamanlı Tema" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Belirtilen saatlerde otomatik açık/koyu geçiş"
                                           FontSize="10" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.EnableScheduledTheme, Mode=TwoWay}"
                                            Click="Settings_Changed" VerticalAlignment="Top"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Açık tema başlangıcı" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="8,5">
                                    <TextBox Background="Transparent" Foreground="White" BorderThickness="0"
                                             FontSize="12.5"
                                             Text="{Binding Settings.LightThemeStartHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Saat (0-23)"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Koyu tema başlangıcı" FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
                                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="8,5">
                                    <TextBox Background="Transparent" Foreground="White" BorderThickness="0"
                                             FontSize="12.5"
                                             Text="{Binding Settings.DarkThemeStartHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Saat (0-23)"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,8,0,14"/>

                        <!-- ICONS -->
                        <TextBlock Text="İKONLAR" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Bluetooth" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowBluetooth, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Wi-Fi" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowWifi, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Pil" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowBattery, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="VPN" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowVpn, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mikrofon Göstergesi" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowMicrophone, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Kamera Göstergesi" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowCamera, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Medya Kontrolü" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowMedia, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>
                        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Parlaklık" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowBrightness, Mode=TwoWay}" Click="Settings_Changed"/>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,8,0,14"/>

                        <!-- MULTI-MONITOR -->
                        <TextBlock Text="ÇOKLU MONİTÖR" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Çoklu Monitör Desteği" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Her monitörde ayrı bar gösterir"
                                           FontSize="10" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.EnableMultiMonitor, Mode=TwoWay}"
                                            Click="MultiMonitor_Changed" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid Margin="0,0,0,10"
                              Visibility="{Binding Settings.EnableMultiMonitor, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Monitörleri Senkronize Et" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Tüm monitörlerde aynı ayarları kullanır"
                                           FontSize="10" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SyncMonitors, Mode=TwoWay}"
                                            Click="SyncMonitors_Changed" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Equalize Profiles Button -->
                        <Button Content="📐 Profilleri Eşitle" Margin="0,0,0,18" Padding="0,8"
                                Background="#253366FF" Foreground="#5588FF"
                                BorderBrush="#403366FF" BorderThickness="1"
                                Command="{Binding EqualizeMonitorProfilesCommand}"
                                Cursor="Hand" HorizontalAlignment="Stretch"
                                ToolTip="Tüm monitörlerde aynı ayarları uygula"
                                Visibility="{Binding Settings.EnableMultiMonitor, Converter={StaticResource BoolToVis}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,0,0,14"
                                  Visibility="{Binding Settings.EnableMultiMonitor, Converter={StaticResource BoolToVis}}"/>

                        <!-- MEDIA / LYRICS -->
                        <TextBlock Text="MEDYA &amp; ŞARKI SÖZLERİ" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Album Kapağını Göster" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Medya popup'ında büyük album kapağı"
                                           FontSize="10" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowAlbumArt, Mode=TwoWay}"
                                            Click="Settings_Changed" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Şarkı Sözlerini Göster" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Album kapağına tıklayınca sözleri gösterir"
                                           FontSize="10" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowLyrics, Mode=TwoWay}"
                                            Click="Settings_Changed" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bar'da Şarkı Sözlerini Göster" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Şarkının saniyesine göre anlık şarkı sözlerini bar üzerinde gösterir (karaoke modu)"
                                           FontSize="10" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowLyricsInBar, Mode=TwoWay}"
                                            Click="Settings_Changed" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Close Button -->
                        <Button Content="Kapat" Padding="0,10" Background="#25FF3B30" Foreground="#FF3B30"
                                BorderBrush="#40FF3B30" BorderThickness="1"
                                Click="CloseSettings_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- CENTER LAYER: Media Controls — oynatılıyor VEYA duraklatılmış iken görünür -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"
                    MaxWidth="520">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CurrentMedia.HasMedia}" Value="True"/>
                                <Condition Binding="{Binding Settings.ShowMedia}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Kapak fotoğrafı (Spotify, YouTube Music, tarayıcı vs.) - Tıklanabilir -->
            <ToggleButton x:Name="BtnMediaLyrics" Style="{StaticResource TrayToggleBtn}" Padding="0" Margin="0,0,8,0">
                <Border Width="22" Height="22" CornerRadius="3"
                        VerticalAlignment="Center"
                        Visibility="{Binding CurrentMedia.HasMedia, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding CurrentMedia.Thumbnail}"
                                    Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </ToggleButton>

            <!-- Önceki -->
            <ui:Button Appearance="Transparent" Padding="4,0" Foreground="White"
                       Command="{Binding PreviousMediaCommand}" Margin="0,0,8,0">
                <ui:SymbolIcon Symbol="Previous24" FontSize="14"/>
            </ui:Button>

            <!-- Oynat / Durdur -->
            <ui:Button Appearance="Transparent" Padding="4,0" Foreground="White"
                       Command="{Binding PlayPauseMediaCommand}" Margin="0,0,8,0">
                <ui:SymbolIcon Symbol="{Binding CurrentMedia.PlayPauseIcon}" FontSize="16"/>
            </ui:Button>

            <!-- Sonraki -->
            <ui:Button Appearance="Transparent" Padding="4,0" Foreground="White"
                       Command="{Binding NextMediaCommand}" Margin="0,0,12,0">
                <ui:SymbolIcon Symbol="Next24" FontSize="14"/>
            </ui:Button>

            <!-- Lyrics Mode: Bar'da anlık şarkı sözü gösterimi -->
            <TextBlock Text="{Binding CurrentLyricLine}"
                       FontWeight="SemiBold" FontSize="12.5" FontStyle="Italic"
                       Foreground="#FFDD66"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="350" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Settings.ShowLyricsInBar}" Value="True"/>
                                    <Condition Binding="{Binding CurrentMedia.IsPlaying}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Normal Mode: Başlık ve Sanatçı -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Settings.ShowLyricsInBar}" Value="True"/>
                                    <Condition Binding="{Binding CurrentMedia.IsPlaying}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <TextBlock Text="{Binding CurrentMedia.Title}"
                           FontWeight="SemiBold" FontSize="12"
                           Margin="0,0,4,0" TextTrimming="CharacterEllipsis"
                           MaxWidth="150" VerticalAlignment="Center"/>
                <TextBlock Text="-" FontSize="12" Foreground="#888888"
                           Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentMedia.Artist}"
                           FontSize="12" Foreground="#AAAAAA"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="150" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Media/Lyrics Popup -->
        <Popup x:Name="MediaLyricsPopup" IsOpen="{Binding IsChecked, ElementName=BtnMediaLyrics}" 
               StaysOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnMediaLyrics}"
               HorizontalOffset="-180"
               VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade"
               Opened="MediaLyricsPopup_Opened">
            <Border Style="{StaticResource PopupBorder}" Width="420" MaxHeight="500" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Album Art -->
                    <Border Grid.Row="0" Background="#15FFFFFF" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Large Album Art -->
                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8" Margin="0,0,14,0"
                                    Visibility="{Binding Settings.ShowAlbumArt, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <Binding Path="CurrentMedia.Thumbnail" FallbackValue="{x:Null}"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="3" Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <!-- Song Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentMedia.Title}" 
                                           FontWeight="Bold" FontSize="15"
                                           TextWrapping="Wrap" MaxWidth="280"
                                           Foreground="White" Effect="{x:Null}"/>
                                <TextBlock Text="{Binding CurrentMedia.Artist}" 
                                           FontSize="13" Foreground="#AAAAAA"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Effect="{x:Null}"/>
                                
                                <!-- Lyrics Toggle -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Şarkı Sözleri" 
                                               FontSize="11" Foreground="#888" 
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Effect="{x:Null}"/>
                                    <ui:ToggleSwitch Grid.Column="1" 
                                                    IsChecked="{Binding Settings.ShowLyrics, Mode=TwoWay}"
                                                    Click="ShowLyrics_Changed"
                                                    HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Lyrics Content -->
                    <Border Grid.Row="1" Padding="20,16"
                            Visibility="{Binding Settings.ShowLyrics, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <StackPanel>
                                <!-- Loading State -->
                                <TextBlock Text="Şarkı sözleri yükleniyor..." 
                                           FontSize="12" Foreground="#666"
                                           TextAlignment="Center" Margin="0,20"
                                           Effect="{x:Null}"
                                           Visibility="{Binding IsLoadingLyrics, Converter={StaticResource BoolToVis}}"/>

                                <!-- Lyrics Text -->
                                <TextBlock Text="{Binding CurrentLyrics.Lyrics}" 
                                           FontSize="12.5" Foreground="#CCCCCC"
                                           TextWrapping="Wrap" LineHeight="20"
                                           Effect="{x:Null}"
                                           Visibility="{Binding CurrentLyrics.IsAvailable, Converter={StaticResource BoolToVis}}"/>

                                <!-- No Lyrics State -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,20"
                                           Visibility="{Binding IsLoadingLyrics, Converter={StaticResource BoolToVis}}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsLoadingLyrics}" Value="False"/>
                                                        <Condition Binding="{Binding CurrentLyrics.IsAvailable}" Value="False"/>
                                                        <Condition Binding="{Binding Settings.ShowLyrics}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="32" 
                                                   Foreground="#444" Margin="0,0,0,10"
                                                   Effect="{x:Null}"/>
                                    <TextBlock Text="Şarkı sözleri bulunamadı" 
                                               FontSize="12" Foreground="#666"
                                               TextAlignment="Center"
                                               Effect="{x:Null}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- LEFT & RIGHT LAYER -->
        <Grid Margin="15,0">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Logo and Active Window Title only -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                <ui:SymbolIcon Symbol="Grid24" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Başlat"/>
                <TextBlock Text="{Binding ActiveWindowTitle, NotifyOnTargetUpdated=True}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" ToolTip="Aktif Pencere">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.4"/>
                                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="10,0,0,0" To="0,0,0,0" Duration="0:0:0.3">
                                        <ThicknessAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>

                <!-- Volume Level (No popup, just display) -->
                <Rectangle Width="1" Height="14" Fill="#25FFFFFF" Margin="15,0,10,0" VerticalAlignment="Center"/>
                <ui:SymbolIcon Symbol="{Binding VolumeIcon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Ses Seviyesi"/>
                <TextBlock Text="{Binding VolumeLevel, StringFormat='{}%{0}'}" FontSize="12.5" VerticalAlignment="Center" ToolTip="Ses Seviyesi"/>
            </StackPanel>

            <!-- RIGHT: Tray Icons, Date, Time -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Stretch" Margin="6,0">

                <!-- Task View -->
                <Button Style="{StaticResource TrayBtn}" Margin="0,0,1,0"
                        Command="{Binding OpenTaskViewCommand}" ToolTip="Görev Görünümü"
                        Visibility="{Binding Settings.ShowTaskView, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="TabDesktop24" FontSize="15" Foreground="White"/>
                </Button>

                <!-- Virtual Desktops -->
                <Button Style="{StaticResource TrayBtn}" Margin="0,0,1,0"
                        Command="{Binding OpenVirtualDesktopsCommand}" ToolTip="Sanal Masaüstleri"
                        Visibility="{Binding Settings.ShowTaskView, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="DesktopFlow24" FontSize="15" Foreground="White"/>
                </Button>

                <!-- Screenshot -->
                <Button Style="{StaticResource TrayBtn}" Margin="0,0,6,0"
                        Command="{Binding TakeScreenshotCommand}" ToolTip="Ekran Görüntüsü"
                        Visibility="{Binding Settings.ShowScreenshot, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Screenshot24" FontSize="15" Foreground="White"/>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="14" Fill="#25FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>

                <!-- Bluetooth -->
                <ToggleButton x:Name="BtnBluetooth" Margin="0,0,1,0" ToolTip="Bluetooth">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource TrayToggleBtn}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasBluetooth}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowBluetooth}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <ui:SymbolIcon Symbol="Bluetooth24" FontSize="15" Foreground="White"/>
                </ToggleButton>
                <!-- Bluetooth Popup visibility tied to button -->
                <Popup IsOpen="{Binding IsChecked, ElementName=BtnBluetooth}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=BtnBluetooth}" Placement="Bottom"
                       VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource PopupBorder}" Width="290" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Bluetooth24" FontSize="20" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Bluetooth" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding BluetoothDevices}"
                                     ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                                     Background="Transparent" BorderThickness="0" Foreground="White"
                                     MaxHeight="280" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" Background="Transparent">
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ToggleBluetoothPairingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4" Margin="0,0,10,0" Grid.Column="0">
                                                <ui:SymbolIcon Symbol="Bluetooth24" FontSize="14" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                            <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="4" Padding="5,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Popup>


                
                <!-- Wi-Fi / Network -->
                <ToggleButton x:Name="BtnWifi" Style="{StaticResource TrayToggleBtn}" Margin="0,0,4,0"
                              ToolTip="{Binding NetworkName}" IsHitTestVisible="{Binding HasWifi}"
                              Visibility="{Binding Settings.ShowWifi, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="{Binding CurrentNetworkIcon}" FontSize="15" Foreground="White"/>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=BtnWifi}" Closed="PopupWifi_Closed"
                       StaysOpen="False" PlacementTarget="{Binding ElementName=BtnWifi}"
                       Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource PopupBorder}" Width="310" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="{Binding CurrentNetworkIcon}" FontSize="20" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Ağ Bağlantıları" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding AvailableNetworks}"
                                     ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                                     Background="Transparent" BorderThickness="0" Foreground="White"
                                     MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1" Background="Transparent">
                                            <Grid>
                                                <Grid.ContextMenu>
                                                    <ContextMenu Background="#E6181818" Foreground="White" BorderThickness="1" BorderBrush="#33FFFFFF">
                                                        <MenuItem Header="Ağı Unut" Command="{Binding DataContext.ForgetWifiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#FF5555"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectWifiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.DisconnectWifiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="{Binding SignalIcon}" Margin="0,0,10,0" Grid.Column="0" FontSize="16" Foreground="White"/>
                                                <TextBlock Text="{Binding Ssid}" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5" FontWeight="SemiBold"/>
                                                <Border Grid.Column="2" CornerRadius="4" Padding="5,2" Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="Bağlı">
                                                                    <Setter Property="Background" Value="#2234C759"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#888"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="Bağlı">
                                                                        <Setter Property="Foreground" Value="#34C759"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <!-- Password Prompt -->
                                            <Border Margin="34,8,0,2" CornerRadius="6" Background="#12FFFFFF"
                                                    Padding="10,8"
                                                    Visibility="{Binding IsPasswordPromptVisible, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="Ağ Şifresi" FontSize="11" Margin="0,0,0,6" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#1AFFFFFF" CornerRadius="5" Margin="0,0,6,0">
                                                            <PasswordBox x:Name="TxtPassword" Background="Transparent" Foreground="White"
                                                                         BorderThickness="0" Padding="6,4" FontSize="12">
                                                                <PasswordBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Command="{Binding DataContext.ConnectWifiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ElementName=TxtPassword}"/>
                                                                </PasswordBox.InputBindings>
                                                            </PasswordBox>
                                                        </Border>
                                                        <ui:Button Grid.Column="1" Content="Bağlan"
                                                                   Command="{Binding DataContext.ConnectWifiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding ElementName=TxtPassword}"
                                                                   FontSize="11" Padding="10,4" Appearance="Primary"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Mic Active Indicator -->
                <Border Margin="0,0,4,0" Padding="6,0" CornerRadius="5" Background="#15FF9500"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMicrophoneActive}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowMicrophone}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="#FF9500" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:SymbolIcon Symbol="Mic24" FontSize="14" Foreground="#FF9500"/>
                    </StackPanel>
                </Border>

                <!-- Camera Active Indicator -->
                <Border Margin="0,0,4,0" Padding="6,0" CornerRadius="5" Background="#1534C759"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCameraActive}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowCamera}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="#34C759" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:SymbolIcon Symbol="Camera24" FontSize="14" Foreground="#34C759"/>
                    </StackPanel>
                </Border>

                <!-- VPN Status -->
                <Border Margin="0,0,4,0" Padding="6,0" CornerRadius="5" Background="#1530D158"
                        VerticalAlignment="Center" ToolTip="{Binding VpnName}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsVpnConnected}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowVpn}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="14" Foreground="#30D158"/>
                </Border>

                <!-- Battery (only if laptop + setting enabled) -->
                <Border Margin="0,0,2,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TrayBox}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Battery.HasBattery}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowBattery}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding Battery.Icon}" FontSize="15">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Battery.IsCharging}" Value="True">
                                            <Setter Property="Foreground" Value="#34C759"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Battery.Level}" Value="10">
                                            <Setter Property="Foreground" Value="#FF3B30"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </StackPanel>
                </Border>

                <!-- Brightness (laptop only, setting controlled) -->
                <ToggleButton x:Name="BtnBrightness" Margin="0,0,2,0" ToolTip="{Binding BrightnessLevel, StringFormat='Parlaklık: %{0}'}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource TrayToggleBtn}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasBrightnessControl}" Value="True"/>
                                        <Condition Binding="{Binding Settings.ShowBrightness}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="15" Foreground="#FFD60A"/>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=BtnBrightness}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=BtnBrightness}" Placement="Bottom"
                       VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource PopupBorder}" Width="250" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="WeatherSunny24" FontSize="18" Foreground="#FFD60A" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="Parlaklık" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding BrightnessLevel, StringFormat=' {0}%'}" FontSize="13"
                                           Foreground="#888" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    Value="{Binding BrightnessLevel, Mode=TwoWay}"
                                    ValueChanged="BrightnessSlider_Changed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <ui:SymbolIcon Symbol="WeatherSunny16" FontSize="12" Foreground="#666"/>
                                <TextBlock Text=" Düşük        Yüksek " FontSize="10" Foreground="#555" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="16" Foreground="#FFD60A"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Weather Widget -->
                <Border CornerRadius="6" Padding="8,0" Margin="4,0,8,0" ToolTip="{Binding WeatherTooltip}">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="{Binding Settings.WeatherOpacity}" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding WeatherIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                        <TextBlock Text="{Binding WeatherCondition}" FontSize="12.5" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Date and Time -->
                <ToggleButton x:Name="BtnCalendar" Style="{StaticResource TrayToggleBtn}" Margin="4,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentDate}" FontSize="12" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentTime}" FontWeight="Bold" FontSize="13.5" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="CalendarPopup" IsOpen="{Binding IsChecked, ElementName=BtnCalendar}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=BtnCalendar}" Placement="Bottom" HorizontalOffset="-280"
                       VerticalOffset="0" AllowsTransparency="True" PopupAnimation="Fade"
                       Opened="CalendarPopup_Opened">
                    <Border Width="360" CornerRadius="14"
                            BorderBrush="#30FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#EF1C1C2E" Offset="0"/>
                                <GradientStop Color="#EF12121E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" Opacity="0.6" ShadowDepth="6" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Header -->
                            <Border CornerRadius="14,14,0,0" Padding="22,20,22,14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF3A3A6E" Offset="0"/>
                                        <GradientStop Color="#FF1C1C3A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding CurrentTime}" FontSize="44" FontWeight="Light"
                                                   Foreground="White" FontFamily="Segoe UI Light, Segoe UI"
                                                   Effect="{x:Null}"/>
                                        <TextBlock Text="{Binding CurrentDate}" FontSize="13"
                                                   Foreground="#A0B4FF" Effect="{x:Null}"/>
                                    </StackPanel>
                                    <!-- Today button -->
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Padding="10,5"
                                            Background="#22FFFFFF" Foreground="White" BorderThickness="0"
                                            Cursor="Hand" FontSize="11"
                                            Command="{Binding NavigateCalendarCommand}" CommandParameter="0"
                                            ToolTip="Bugüne Git"
                                            Click="CalendarTodayBtn_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TodayBg" Background="#22FFFFFF" CornerRadius="6" Padding="10,5">
                                                    <TextBlock Text="Bugün" FontSize="11" Foreground="#A0B4FF" Effect="{x:Null}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TodayBg" Property="Background" Value="#35FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Month Navigation -->
                            <Grid Margin="16,14,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource TrayBtn}" Padding="8,4"
                                        Command="{Binding NavigateCalendarCommand}" CommandParameter="-1">
                                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" Foreground="White"/>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding CalendarMonthName}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold" Foreground="White"
                                           Effect="{x:Null}"/>
                                <Button Grid.Column="2" Style="{StaticResource TrayBtn}" Padding="8,4"
                                        Command="{Binding NavigateCalendarCommand}" CommandParameter="1">
                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" Foreground="White"/>
                                </Button>
                            </Grid>

                            <!-- Day headers (Pzt Sal Çar ...) -->
                            <UniformGrid Rows="1" Columns="7" Margin="16,4,16,6">
                                <TextBlock Text="Pt" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#6070A0" Effect="{x:Null}"/>
                                <TextBlock Text="Sa" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#6070A0" Effect="{x:Null}"/>
                                <TextBlock Text="Ça" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#6070A0" Effect="{x:Null}"/>
                                <TextBlock Text="Pe" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#6070A0" Effect="{x:Null}"/>
                                <TextBlock Text="Cu" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#6070A0" Effect="{x:Null}"/>
                                <TextBlock Text="Ct" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF6B6B" Effect="{x:Null}"/>
                                <TextBlock Text="Pa" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF6B6B" Effect="{x:Null}"/>
                            </UniformGrid>

                            <!-- Day Grid -->
                            <ItemsControl ItemsSource="{Binding CalendarDays}" Margin="10,0,10,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2" CornerRadius="6" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <!-- Today = vibrant accent -->
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#FF6C63FF" Offset="0"/>
                                                                        <GradientStop Color="#FF4EA8DE" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <!-- Special/holiday = soft red -->
                                                        <DataTrigger Binding="{Binding IsSpecialDay}" Value="True">
                                                            <Setter Property="Background" Value="#25FF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ToolTip>
                                                <TextBlock Text="{Binding SpecialDayName}"/>
                                            </Border.ToolTip>
                                            <TextBlock Text="{Binding Day}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontSize="12.5"
                                                       Margin="0,5" Effect="{x:Null}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#C0CEFF"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter Property="Foreground" Value="#40607090"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF8080"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSpecialDay}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF7070"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
